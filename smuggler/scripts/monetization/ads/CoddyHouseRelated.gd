## Position of `id` in the host's list (0 = most related); ids not in the table rank after every known one.
static func rank(host: String, id: String) -> int:
	var lst: Array = RELATED.get(host, [])
	var i := lst.find(id)
	return i if i >= 0 else 1000


## Stable relatedness order: known ids by rank, then unknown ids in their incoming (backend) order. Never the host or a
## kids game. `top` > 0 keeps only that many.
static func ordered(seq: Array, host: String, top: int = TOP_N) -> Array:
	var keyed: Array = []
	var seen := {}
	for i in seq.size():
		var c = seq[i]
		if not (c is Dictionary):
			continue
		var id := str(c.get("promotedAppId", ""))
		if id == "" or id == host or NEVER.has(id) or seen.has(id):
			continue
		seen[id] = true
		keyed.append([rank(host, id), i, c])
	keyed.sort_custom(func(a, b): return a[0] < b[0] or (a[0] == b[0] and a[1] < b[1]))
	var out: Array = []
	for k in keyed:
		out.append(k[2])
		if top > 0 and out.size() >= top:
			break
	return out


## In place on an ads-config dictionary (see the header). Returns true when it changed something. Cheap when already
## applied (one lookup): safe to call every banner check / interstitial break.
static func apply(config: Dictionary, host: String) -> bool:
	if host == "" or not (config.get("houseAds") is Dictionary):
		return false
	var h: Dictionary = config["houseAds"]
	var mark := "%s:%d" % [host, VERSION]
	if str(h.get(MARK, "")) == mark:
		return false
	var fmts := ["banner", "interstitial"]
	var src := {}
	for f in fmts:
		var fc = h.get(f)
		src[f] = (fc.get("sequence", []) if fc.get("sequence", []) is Array else []) if fc is Dictionary else []
	for f in fmts:
		var fc = h.get(f)
		if not (fc is Dictionary):
			continue
		var other: String = fmts[1] if f == fmts[0] else fmts[0]
		fc["sequence"] = ordered(src[f] + src[other], host)
	h[MARK] = mark
	return true
