# Jenkins Games/smuggler-mobile (games/jenkins/README.md). Sourced by sh; no secrets here.
# Borderline Empire. Linux Android BUILD-ONLY (label android-linux, 2026-10-27): the old Mac pipeline defaulted to
# ANDROID_ACTION=production and uploaded on a plain "Build" — replaced. Upload key on the agent:
# ~/.android-keys/borderlineempire/ (700/600, same SHA-256 as the Mini copy). iOS (ios/plugins from
# /Volumes/BuildSSD/game-deps/BorderlineEmpire/) is paused for games; tools/build_ios.sh runs by hand on the Mac.
NAME=BorderlineEmpire
ENGINE=godot
ASC_APP_ID=6821004024
BUNDLE_ID=com.coddykit.borderlineempire
PLAY_PACKAGE=com.coddykit.borderlineempire
PIPELINE_TEMPLATE=game-android-build-only.Jenkinsfile.in
