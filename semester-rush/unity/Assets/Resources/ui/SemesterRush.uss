/* Semester Rush — game styles on top of the CoddyKit theme (CoddyTokens.uss / CoddyKit.uss). Fleet UI rules: ≥ 48 dp
   touch targets (--touch-min), ≥ 14 sp body text, every toast a card, no raw Unity look, no visible scrollbar. */
.sr-root { flex-grow: 1; }
.sr-hud { position: absolute; left: 0; right: 0; top: 0; flex-direction: column; padding: var(--space-s) var(--space-m); }
.sr-hud__row { flex-direction: row; align-items: center; justify-content: space-between; }
.sr-chip { flex-direction: row; align-items: center; background-color: var(--surface); border-radius: var(--radius-pill);
  padding: var(--space-xs) var(--space-m); margin-right: var(--space-xs); margin-top: var(--space-xxs); min-height: var(--touch-min); }
.sr-chip__label { font-size: var(--type-label); color: var(--on-surface); -unity-font-style: bold; }
.sr-chip--money .sr-chip__label { color: var(--success); }
.sr-chip--prestige .sr-chip__label { color: var(--primary); }
.sr-chip--warn { background-color: var(--warning-container); }
.sr-crises { flex-direction: row; flex-wrap: wrap; flex-shrink: 1; }
.sr-speed { flex-direction: row; }
.sr-speed__btn { min-width: var(--touch-min); min-height: var(--touch-min); margin-left: var(--space-xxs); border-radius: var(--radius-pill);
  background-color: var(--surface); color: var(--on-surface); font-size: var(--type-label); -unity-font-style: bold; border-width: 0; }
.sr-speed__btn--on { background-color: var(--primary); color: var(--on-primary); }
.sr-main-action { margin-top: var(--space-s); align-self: center; min-width: 220px; }

.sr-bottom { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: column; }
.sr-tabs { flex-direction: row; background-color: var(--surface); min-height: var(--touch-tab-bar); border-top-left-radius: var(--radius-l); border-top-right-radius: var(--radius-l); }
.sr-tab { flex-grow: 1; flex-basis: 0; min-height: var(--touch-tab-bar); background-color: rgba(0,0,0,0); border-width: 0;
  font-size: var(--type-caption); color: var(--on-surface-muted); -unity-font-style: bold; white-space: normal; }
.sr-tab--on { color: var(--primary); }

.sr-markers { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.sr-marker { position: absolute; min-width: var(--touch-min); min-height: var(--touch-min); margin-left: -48px; margin-top: -56px; max-width: 128px;
  padding: 0 var(--space-s); border-radius: var(--radius-pill); background-color: var(--surface); border-width: 2px; border-color: var(--outline);
  align-items: center; justify-content: center; }
.sr-marker__label { font-size: var(--type-caption); color: var(--on-surface); -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.sr-marker--hall { border-color: var(--primary); }
.sr-marker--selected { background-color: var(--primary); }
.sr-marker--selected .sr-marker__label { color: var(--on-primary); }
.sr-marker--site { background-color: var(--surface-high); border-color: var(--accent); }
.sr-marker--gate { background-color: var(--warning-container); border-color: var(--warning); }
.sr-marker--coins { background-color: var(--accent); border-color: var(--accent); }
.sr-marker--coins .sr-marker__label { color: var(--on-accent); }

.sr-pills { flex-direction: row; flex-wrap: wrap; margin-top: var(--space-xxs); }
.sr-board { flex-direction: column; margin: var(--space-s) 0; }
.sr-board__row { flex-direction: row; align-items: center; }
.sr-board__time { width: 48px; font-size: var(--type-caption); color: var(--on-surface-muted); -unity-text-align: middle-center; }
.sr-board__time--lunch { color: var(--warning); -unity-font-style: bold; }
.sr-board__day { flex-grow: 1; flex-basis: 0; font-size: var(--type-caption); color: var(--on-surface-muted); -unity-text-align: middle-center; -unity-font-style: bold; }
.sr-cell { flex-grow: 1; flex-basis: 0; min-height: var(--touch-min); margin: 2px; border-radius: var(--radius-s); border-width: 2px; border-color: var(--outline);
  background-color: var(--surface); color: var(--on-surface); font-size: var(--type-caption); -unity-font-style: bold; padding: 0; white-space: normal; }
.sr-cell--selected { border-color: var(--accent); border-width: 3px; }
.sr-cell--past { opacity: 0.45; }
.sr-cell--now { border-color: var(--primary); border-width: 3px; }
.sr-cell--warn { border-color: var(--warning); }
.sr-cell--fac0 { background-color: rgb(59, 91, 169); color: rgb(255, 255, 255); }
.sr-cell--fac1 { background-color: rgb(125, 79, 168); color: rgb(255, 255, 255); }
.sr-cell--fac2 { background-color: rgb(184, 58, 75); color: rgb(255, 255, 255); }
.sr-cell--fac3 { background-color: rgb(47, 158, 150); color: rgb(255, 255, 255); }
.sr-cell--fac4 { background-color: rgb(229, 129, 58); color: rgb(255, 255, 255); }
.sr-cell--fac5 { background-color: rgb(76, 175, 106); color: rgb(255, 255, 255); }
.sr-cell--fac6 { background-color: rgb(217, 165, 32); color: rgb(40, 30, 10); }
.sr-warn-text { font-size: var(--type-body); color: var(--warning); -unity-font-style: bold; }

.sr-coach { position: absolute; left: var(--space-m); right: var(--space-m); bottom: 120px; background-color: var(--surface-high);
  border-radius: var(--radius-l); padding: var(--space-m); flex-direction: row; align-items: center; }
.sr-coach--top { bottom: auto; top: 150px; }
.sr-coach__face { width: 72px; height: 72px; border-radius: 36px; margin-right: var(--space-m); background-color: var(--primary-container); flex-shrink: 0; }
.sr-coach__texts { flex-shrink: 1; flex-grow: 1; }
.sr-coach__text { font-size: var(--type-body); color: var(--on-surface); white-space: normal; }
.sr-coach__step { font-size: var(--type-caption); color: var(--on-surface-muted); margin-top: var(--space-xxs); }
.sr-coach__skip { align-self: flex-start; }
.sr-spot { position: absolute; width: 96px; height: 96px; margin-left: -48px; margin-top: -48px; border-radius: 48px;
  border-width: 4px; border-color: var(--accent); }

.sr-report__big { align-items: center; margin: var(--space-s) 0; }
.sr-report__grade { font-size: var(--type-headline); color: var(--primary); -unity-font-style: bold; }
.sr-row { flex-direction: row; justify-content: space-between; padding: var(--space-xxs) 0; }
.sr-row__k { font-size: var(--type-body); color: var(--on-surface-muted); flex-shrink: 1; white-space: normal; }
.sr-row__v { font-size: var(--type-body); color: var(--on-surface); -unity-font-style: bold; }
.sr-row__v--good { color: var(--success); }
.sr-row__v--bad { color: var(--danger); }

.sr-pager { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--background); padding: var(--space-xl) var(--space-l); }
.sr-pager__art { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; margin-bottom: var(--space-l); }
.sr-pager__title { font-size: var(--type-headline); color: var(--on-surface); -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.sr-pager__body { font-size: var(--type-body-l); color: var(--on-surface-muted); -unity-text-align: middle-center; white-space: normal; margin: var(--space-s) 0 var(--space-l) 0; }
.sr-pager__dots { flex-direction: row; justify-content: center; margin-bottom: var(--space-l); }
.sr-pager__dot { width: 10px; height: 10px; border-radius: 5px; margin: 0 6px; background-color: var(--outline); }
.sr-pager__dot--on { background-color: var(--primary); width: 26px; }
.sr-pager__actions { flex-direction: row; justify-content: space-between; align-items: center; }
