/* Pour & Roast — game styles on top of the CoddyKit theme (CoddyTokens.uss / CoddyKit.uss). Fleet UI rules: ≥ 48 dp
   touch targets (--touch-min), ≥ 14 sp body text, every toast a card, no raw Unity look, no visible scrollbar. */
.pr-root { flex-grow: 1; }
.pr-hud { position: absolute; left: 0; right: 0; top: 0; flex-direction: column; padding: var(--space-s) var(--space-m); }
.pr-hud__row { flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.pr-chip { flex-direction: row; align-items: center; background-color: var(--surface); border-radius: var(--radius-pill); border-width: 0;
  padding: var(--space-xs) var(--space-m); margin-right: var(--space-xs); margin-top: var(--space-xxs); min-height: var(--touch-min); }
.pr-chip__label { font-size: var(--type-label); color: var(--on-surface); -unity-font-style: bold; }
.pr-chip--money .pr-chip__label { color: var(--success); }
.pr-chip--warn { background-color: var(--warning-container); }
.pr-crises { flex-direction: row; flex-wrap: wrap; }
.pr-speed { flex-direction: row; }
.pr-speed__btn { min-width: var(--touch-min); min-height: var(--touch-min); margin-left: var(--space-xxs); border-radius: var(--radius-pill);
  background-color: var(--surface); color: var(--on-surface); font-size: var(--type-label); -unity-font-style: bold; border-width: 0; }
.pr-speed__btn--on { background-color: var(--primary); color: var(--on-primary); }

/* the ticket rail: a wooden strip with paper tickets clipped on it */
.pr-rail-row { flex-direction: row; align-items: stretch; margin-top: var(--space-s); }
.pr-rail { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 72px; background-color: rgba(110, 75, 53, 0.85);
  border-radius: var(--radius-m); padding: var(--space-xxs); overflow: hidden; align-items: stretch; }
.pr-rail--empty { opacity: 0.6; }
.pr-rail__more { color: #F3E6CF; font-size: var(--type-label); -unity-font-style: bold; align-self: center; margin: 0 var(--space-xs); }
.pr-ticket { flex-grow: 1; flex-basis: 0; min-width: 52px; max-width: 96px; min-height: 64px; margin: 0 2px; padding: var(--space-xxs);
  background-color: #FBF7EE; border-radius: var(--radius-xs); border-width: 0; border-top-width: 4px; border-color: #C9CED3;
  flex-direction: column; justify-content: space-between; }
.pr-ticket__items { font-size: var(--type-label); color: #2B2B2E; -unity-font-style: bold; white-space: normal; -unity-text-align: upper-left; }
.pr-ticket__sub { font-size: var(--type-caption); color: #6E4B35; -unity-text-align: upper-left; }
.pr-ticket__bar-bg { height: 5px; background-color: #E8D9B5; border-radius: 2px; overflow: hidden; }
.pr-ticket__bar { height: 5px; width: 100%; background-color: var(--success); }
.pr-ticket__bar--low { background-color: var(--danger); }
.pr-ticket--selected { border-color: var(--accent); border-width: 3px; border-top-width: 4px; }
.pr-ticket--pre { border-top-color: #2C7A7B; }
.pr-ticket--working { background-color: #FFF1DD; }
.pr-batch { min-width: 64px; min-height: var(--touch-min); margin-left: var(--space-xs); border-radius: var(--radius-m); border-width: 0;
  background-color: var(--surface); color: var(--on-surface); font-size: var(--type-caption); -unity-font-style: bold; white-space: normal; }
.pr-batch--on { background-color: var(--primary); color: var(--on-primary); }
.pr-main-action { margin-top: var(--space-s); align-self: center; min-width: 220px; }

.pr-bottom { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: column; }
.pr-tabs { flex-direction: row; background-color: var(--surface); min-height: var(--touch-tab-bar); border-top-left-radius: var(--radius-l); border-top-right-radius: var(--radius-l); }
.pr-tab { flex-grow: 1; flex-basis: 0; min-height: var(--touch-tab-bar); min-width: var(--touch-min); background-color: rgba(0,0,0,0); border-width: 0;
  font-size: var(--type-caption); color: var(--on-surface-muted); -unity-font-style: bold; white-space: normal; }
.pr-tab--on { color: var(--primary); }
.pr-ticketbar { flex-direction: column; background-color: var(--surface-high); margin: 0 var(--space-m) var(--space-s) var(--space-m);
  border-radius: var(--radius-l); padding: var(--space-s) var(--space-m); }
.pr-ticketbar__row { flex-direction: row; align-items: center; justify-content: space-between; margin-top: var(--space-xs); flex-wrap: wrap; }
.pr-ticketbar__sub { font-size: var(--type-caption); color: var(--on-surface-muted); white-space: normal; }

/* station markers over the diorama */
.pr-markers { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.pr-marker { position: absolute; min-width: 64px; min-height: var(--touch-min); margin-left: -32px; margin-top: -48px; padding: var(--space-xxs) var(--space-xs);
  background-color: var(--surface); border-radius: var(--radius-m); border-width: 2px; border-color: var(--outline); align-items: center; justify-content: center; }
.pr-marker__badge { font-size: var(--type-caption); color: var(--on-surface); -unity-font-style: bold; -unity-text-align: middle-center; }
.pr-marker__gauge { width: 44px; height: 6px; margin-top: 2px; background-color: var(--surface-high); border-radius: 3px; overflow: hidden; }
.pr-marker__fill { height: 6px; width: 50%; background-color: var(--success); }
.pr-marker--go { border-color: var(--primary); background-color: var(--primary-container); }
.pr-marker--warn { border-color: var(--warning); }
.pr-marker--warn .pr-marker__fill { background-color: var(--warning); }
.pr-marker--bad { border-color: var(--danger); background-color: var(--warning-container); }
.pr-marker--bad .pr-marker__fill { background-color: var(--danger); }
.pr-marker--holding { scale: 1.12 1.12; border-color: var(--accent); }

/* the guide */
.pr-coach { position: absolute; left: var(--space-m); right: var(--space-m); bottom: 190px; background-color: var(--surface-high);
  border-radius: var(--radius-l); padding: var(--space-m); flex-direction: row; align-items: center; }
.pr-coach--top { bottom: auto; top: 210px; }
.pr-coach__face { width: 72px; height: 72px; border-radius: 36px; margin-right: var(--space-m); background-color: var(--primary-container); flex-shrink: 0; }
.pr-coach__texts { flex-shrink: 1; flex-grow: 1; }
.pr-coach__text { font-size: var(--type-body); color: var(--on-surface); white-space: normal; }
.pr-coach__step { font-size: var(--type-caption); color: var(--on-surface-muted); margin-top: var(--space-xxs); }
.pr-coach__skip { align-self: flex-start; }
.pr-spot { position: absolute; width: 96px; height: 96px; margin-left: -48px; margin-top: -48px; border-radius: 48px;
  border-width: 4px; border-color: var(--accent); }

/* sheets */
.pr-report__stars { align-items: center; margin: var(--space-s) 0; }
.pr-report__star-value { font-size: var(--type-title); color: var(--accent); -unity-font-style: bold; }
.pr-row { flex-direction: row; justify-content: space-between; padding: var(--space-xxs) 0; }
.pr-row__k { font-size: var(--type-body); color: var(--on-surface-muted); }
.pr-row__v { font-size: var(--type-body); color: var(--on-surface); -unity-font-style: bold; }
.pr-row__v--good { color: var(--success); }
.pr-row__v--bad { color: var(--danger); }

/* intro pager */
.pr-pager { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--background); padding: var(--space-xl) var(--space-l); }
.pr-pager__art { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; margin-bottom: var(--space-l); }
.pr-pager__title { font-size: var(--type-headline); color: var(--on-surface); -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.pr-pager__body { font-size: var(--type-body-l); color: var(--on-surface-muted); -unity-text-align: middle-center; white-space: normal; margin: var(--space-s) 0 var(--space-l) 0; }
.pr-pager__dots { flex-direction: row; justify-content: center; margin-bottom: var(--space-l); }
.pr-pager__dot { width: 10px; height: 10px; border-radius: 5px; margin: 0 6px; background-color: var(--outline); }
.pr-pager__dot--on { background-color: var(--primary); width: 26px; }
.pr-pager__actions { flex-direction: row; justify-content: space-between; align-items: center; }
