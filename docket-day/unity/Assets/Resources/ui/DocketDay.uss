/* Docket Day — game styles on top of the CoddyKit theme (CoddyTokens.uss / CoddyKit.uss). Fleet UI rules: ≥ 48 dp
   touch targets (--touch-min), ≥ 14 sp body text, every toast a card, no raw Unity look, no visible scrollbar. */
.dd-root { flex-grow: 1; }
.dd-hud { position: absolute; left: 0; right: 0; top: 0; flex-direction: column; padding: var(--space-s) var(--space-m); }
.dd-hud__row { flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.dd-chip { flex-direction: row; align-items: center; background-color: var(--surface); border-radius: var(--radius-pill);
  padding: var(--space-xs) var(--space-m); margin-right: var(--space-xs); margin-bottom: var(--space-xxs); min-height: var(--touch-min); }
.dd-chip__label { font-size: var(--type-label); color: var(--on-surface); -unity-font-style: bold; }
.dd-chip--money .dd-chip__label { color: var(--success); }
.dd-chip--trust .dd-chip__label { color: var(--on-surface-muted); }
.dd-chip--warn { background-color: var(--warning-container); }
.dd-crises { flex-direction: row; flex-wrap: wrap; flex-shrink: 1; }
.dd-speed { flex-direction: row; align-items: center; }
.dd-speed__btn { min-width: var(--touch-min); min-height: var(--touch-min); margin-left: var(--space-xxs); border-radius: var(--radius-pill);
  background-color: var(--surface); color: var(--on-surface); font-size: var(--type-label); -unity-font-style: bold; border-width: 0; }
.dd-speed__btn--on { background-color: var(--primary); color: var(--on-primary); }
.dd-ff { min-height: var(--touch-min); margin-left: var(--space-xs); padding: 0 var(--space-m); border-radius: var(--radius-pill); border-width: 0;
  background-color: var(--accent); color: var(--on-accent); font-size: var(--type-label); -unity-font-style: bold; }
.dd-ff--on { background-color: var(--primary); color: var(--on-primary); }
.dd-main-action { margin-top: var(--space-s); align-self: center; min-width: 220px; }

.dd-markers { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.dd-marker { position: absolute; min-width: 140px; min-height: var(--touch-min); margin-left: -70px; margin-top: -48px; border-radius: var(--radius-pill);
  background-color: var(--surface); color: var(--on-surface); font-size: var(--type-label); -unity-font-style: bold; border-width: 0; }
.dd-marker--hot { background-color: var(--accent); color: var(--on-accent); }
.dd-marker--court { background-color: var(--surface-high); }

.dd-bottom { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: column; }
.dd-rail { background-color: var(--surface-high); border-top-left-radius: var(--radius-l); border-top-right-radius: var(--radius-l);
  padding: var(--space-xs) var(--space-s) 0 var(--space-s); }
.dd-rail__head { flex-direction: row; align-items: center; justify-content: space-between; padding: 0 var(--space-xs); }
.dd-rail__title { font-size: var(--type-label); color: var(--on-surface); -unity-font-style: bold; }
.dd-rail__hint { font-size: var(--type-caption); color: var(--on-surface-muted); flex-shrink: 1; white-space: normal; -unity-text-align: middle-right; }
.dd-rail__scroll { height: 238px; }
.dd-col { width: 132px; flex-direction: column; margin-right: var(--space-xxs); padding: var(--space-xxs); border-radius: var(--radius-m); }
.dd-col--today { background-color: var(--surface); }
.dd-col__head { font-size: var(--type-caption); color: var(--on-surface-muted); -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: var(--space-xxs); }
.dd-task { flex-direction: column; align-items: flex-start; min-height: var(--touch-min); margin: 0 0 var(--space-xxs) 0; padding: var(--space-xxs) var(--space-xs);
  border-radius: var(--radius-s); border-width: 0; border-left-width: 6px; background-color: var(--surface); }
.dd-task__title { font-size: var(--type-caption); color: var(--on-surface); -unity-font-style: bold; white-space: nowrap; overflow: hidden; }
.dd-task__line { font-size: var(--type-caption); color: var(--on-surface-muted); white-space: nowrap; overflow: hidden; }
.dd-task__who { font-size: var(--type-caption); color: var(--primary); white-space: nowrap; overflow: hidden; }
.dd-task--hearing { background-color: var(--primary-container); }
.dd-task--soon { border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-color: var(--warning); }
.dd-task--late { border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-color: var(--danger); }
.dd-task--collision { background-color: var(--danger); }
.dd-task--collision .dd-task__title, .dd-task--collision .dd-task__line, .dd-task--collision .dd-task__who { color: var(--on-primary); }
.dd-task--session { opacity: 0.6; }
.dd-task--drop { scale: 1.06 1.06; border-color: var(--accent); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; }
.dd-mc-0 { border-left-color: #4C7FD1; } .dd-mc-1 { border-left-color: #E57A3C; } .dd-mc-2 { border-left-color: #3FB0AC; } .dd-mc-3 { border-left-color: #8E5BB6; }
.dd-mc-4 { border-left-color: #F2B33D; } .dd-mc-5 { border-left-color: #2F8F83; } .dd-mc-6 { border-left-color: #B5654A; } .dd-mc-7 { border-left-color: #7FB069; }
.dd-staff__scroll { height: 96px; margin-top: var(--space-xxs); }
.dd-person { width: 116px; min-height: 84px; margin-right: var(--space-xs); padding: var(--space-xs); border-radius: var(--radius-m); background-color: var(--surface); }
.dd-person--selected { background-color: var(--primary-container); border-width: 3px; border-color: var(--primary); }
.dd-person--suggest { border-width: 3px; border-color: var(--accent); }
.dd-person--off { opacity: 0.45; }
.dd-person__name { font-size: var(--type-label); color: var(--on-surface); -unity-font-style: bold; white-space: nowrap; overflow: hidden; }
.dd-person__role { font-size: var(--type-caption); color: var(--on-surface-muted); white-space: nowrap; overflow: hidden; }
.dd-person__bar { height: 8px; margin-top: var(--space-xxs); border-radius: 4px; background-color: var(--outline); overflow: hidden; }
.dd-person__fill { height: 100%; background-color: var(--success); }
.dd-ghost { position: absolute; left: 0; top: 0; margin-left: -60px; margin-top: -40px; width: 120px; min-height: 56px; border-radius: var(--radius-m);
  background-color: var(--accent); justify-content: center; align-items: center; opacity: 0.92; }
.dd-ghost__label { font-size: var(--type-label); color: var(--on-accent); -unity-font-style: bold; }
.dd-tabs { flex-direction: row; background-color: var(--surface); min-height: var(--touch-tab-bar); }
.dd-tab { flex-grow: 1; flex-basis: 0; min-height: var(--touch-tab-bar); background-color: rgba(0,0,0,0); border-width: 0;
  font-size: var(--type-caption); color: var(--on-surface-muted); -unity-font-style: bold; white-space: normal; }
.dd-tab--on { color: var(--primary); }

.dd-pills { flex-direction: row; flex-wrap: wrap; margin: var(--space-xxs) 0 var(--space-s) 0; }
.dd-card--conflict { border-width: 3px; border-color: #8E5BB6; }
.dd-warn { font-size: var(--type-body); color: var(--danger); white-space: normal; -unity-font-style: bold; }
.dd-good { font-size: var(--type-body); color: var(--success); white-space: normal; -unity-font-style: bold; }

.dd-coach { position: absolute; left: var(--space-m); right: var(--space-m); bottom: 420px; background-color: var(--surface-high);
  border-radius: var(--radius-l); padding: var(--space-m); flex-direction: row; align-items: center; }
.dd-coach--top { bottom: auto; top: 170px; }
.dd-coach__face { width: 72px; height: 72px; border-radius: 36px; margin-right: var(--space-m); background-color: var(--primary-container); flex-shrink: 0;
  -unity-background-scale-mode: scale-and-crop; }
.dd-coach__texts { flex-shrink: 1; flex-grow: 1; }
.dd-coach__text { font-size: var(--type-body); color: var(--on-surface); white-space: normal; }
.dd-coach__step { font-size: var(--type-caption); color: var(--on-surface-muted); margin-top: var(--space-xxs); }
.dd-coach__skip { align-self: flex-start; }
.dd-spot { position: absolute; width: 96px; height: 96px; margin-left: -48px; margin-top: -48px; border-radius: 48px; border-width: 4px; border-color: var(--accent); }

.dd-hearing { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(10, 16, 28, 0.9); padding: var(--space-xl) var(--space-l);
  align-items: center; justify-content: center; }
.dd-hearing__title { font-size: var(--type-title); color: #FFFFFF; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.dd-hearing__stage { flex-direction: row; justify-content: center; align-items: flex-end; height: 300px; margin: var(--space-l) 0; }
.dd-hearing__portrait { width: 30%; height: 100%; -unity-background-scale-mode: scale-to-fit; }
.dd-hearing__judge { height: 115%; }
.dd-hearing__line { font-size: var(--type-headline); color: #FFFFFF; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; min-height: 64px; }
.dd-hearing__odds { font-size: var(--type-body); color: #CFD8E3; margin-top: var(--space-s); }
.dd-hearing__bar { width: 80%; height: 22px; margin-top: var(--space-m); border-radius: 11px; background-color: #3B4A5A; }
.dd-hearing__green { position: absolute; left: 40%; width: 20%; top: 0; bottom: 0; background-color: #3E8E5E; }
.dd-hearing__marker { position: absolute; top: -4px; bottom: -4px; width: 8px; margin-left: -4px; background-color: #F2B33D; border-radius: 4px; }
.dd-hearing__objection { margin-top: var(--space-m); min-width: 240px; }
.dd-hearing__verdict { font-size: var(--type-headline); color: #F2B33D; -unity-font-style: bold; margin: var(--space-l) 0; -unity-text-align: middle-center; white-space: normal; }
.dd-hearing__verdict--won { color: #7FD1A0; }

.dd-report__stars { flex-direction: row; justify-content: space-between; margin: var(--space-s) 0; }
.dd-report__star { flex-grow: 1; align-items: center; }
.dd-report__star-value { font-size: var(--type-title); color: var(--accent); -unity-font-style: bold; }
.dd-row { flex-direction: row; justify-content: space-between; padding: var(--space-xxs) 0; }
.dd-row__k { font-size: var(--type-body); color: var(--on-surface-muted); flex-shrink: 1; white-space: normal; }
.dd-row__v { font-size: var(--type-body); color: var(--on-surface); -unity-font-style: bold; flex-shrink: 1; white-space: normal; -unity-text-align: middle-right; }
.dd-row__v--good { color: var(--success); }
.dd-row__v--bad { color: var(--danger); }

.dd-pager { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--background); padding: var(--space-xl) var(--space-l); }
.dd-pager__art { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; margin-bottom: var(--space-l); }
.dd-pager__title { font-size: var(--type-headline); color: var(--on-surface); -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.dd-pager__body { font-size: var(--type-body-l); color: var(--on-surface-muted); -unity-text-align: middle-center; white-space: normal; margin: var(--space-s) 0 var(--space-l) 0; }
.dd-pager__dots { flex-direction: row; justify-content: center; margin-bottom: var(--space-l); }
.dd-pager__dot { width: 10px; height: 10px; border-radius: 5px; margin: 0 6px; background-color: var(--outline); }
.dd-pager__dot--on { background-color: var(--primary); width: 26px; }
.dd-pager__actions { flex-direction: row; justify-content: space-between; align-items: center; }
