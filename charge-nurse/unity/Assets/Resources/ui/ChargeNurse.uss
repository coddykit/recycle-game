/* Charge Nurse — game styles on top of the CoddyKit theme (CoddyTokens.uss / CoddyKit.uss). Fleet UI rules: ≥ 48 dp
   touch targets (--touch-min), ≥ 14 sp body text, every toast a card, no raw Godot/Unity look, no visible scrollbar. */
.cn-root { flex-grow: 1; }
.cn-hud { position: absolute; left: 0; right: 0; top: 0; flex-direction: column; padding: var(--space-s) var(--space-m); }
.cn-hud__row { flex-direction: row; align-items: center; justify-content: space-between; }
.cn-chip { flex-direction: row; align-items: center; background-color: var(--surface); border-radius: var(--radius-pill);
  padding: var(--space-xs) var(--space-m); margin-right: var(--space-xs); min-height: var(--touch-min); }
.cn-chip__label { font-size: var(--type-label); color: var(--on-surface); -unity-font-style: bold; }
.cn-chip__sub { font-size: var(--type-caption); color: var(--on-surface-muted); margin-left: var(--space-xs); }
.cn-chip--money .cn-chip__label { color: var(--success); }
.cn-chip--warn { background-color: var(--warning-container); }
.cn-crises { flex-direction: row; flex-wrap: wrap; margin-top: var(--space-xs); }
.cn-speed { flex-direction: row; }
.cn-speed__btn { min-width: var(--touch-min); min-height: var(--touch-min); margin-left: var(--space-xxs); border-radius: var(--radius-pill);
  background-color: var(--surface); color: var(--on-surface); font-size: var(--type-label); -unity-font-style: bold; border-width: 0; }
.cn-speed__btn--on { background-color: var(--primary); color: var(--on-primary); }
.cn-main-action { margin-top: var(--space-s); align-self: center; min-width: 220px; }

.cn-bottom { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: column; }
.cn-tabs { flex-direction: row; background-color: var(--surface); min-height: var(--touch-tab-bar); border-top-left-radius: var(--radius-l); border-top-right-radius: var(--radius-l); }
.cn-tab { flex-grow: 1; flex-basis: 0; min-height: var(--touch-tab-bar); background-color: rgba(0,0,0,0); border-width: 0;
  font-size: var(--type-caption); color: var(--on-surface-muted); -unity-font-style: bold; white-space: normal; }
.cn-tab--on { color: var(--primary); }
.cn-lens { flex-direction: row; align-items: center; background-color: var(--surface); border-radius: var(--radius-pill); padding: var(--space-xxs) var(--space-s);
  min-height: var(--touch-min); min-width: var(--touch-min); border-width: 0; margin-right: var(--space-xs); }
.cn-lens--bad { background-color: var(--danger); }
.cn-lens__label { font-size: var(--type-label); color: var(--on-surface); -unity-font-style: bold; }
.cn-lens--bad .cn-lens__label { color: var(--on-primary); }
.cn-main-action--handover { background-color: var(--accent); }
.cn-amb { background-color: var(--surface-high); border-radius: var(--radius-l); padding: var(--space-s) var(--space-m); margin-top: var(--space-s);
  border-left-width: 6px; border-left-color: var(--danger); }
.cn-amb__text { font-size: var(--type-body); color: var(--on-surface); -unity-font-style: bold; white-space: normal; margin-bottom: var(--space-xs); }

.cn-markers { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
/* bay / bed badges: ≥ 48 dp tap targets, colour + symbol (never colour alone) */
.cn-bed { position: absolute; width: 48px; height: 48px; margin-left: -24px; margin-top: -48px; border-radius: 24px; border-width: 2px;
  border-color: var(--outline); background-color: var(--surface); align-items: center; justify-content: center; padding: 0; }
.cn-bed__badge { font-size: var(--type-label); color: var(--on-surface); -unity-font-style: bold; -unity-text-align: middle-center; }
.cn-bed--free { border-color: var(--success); }
.cn-bed--empty { opacity: 0.55; }
.cn-bed--dirty { background-color: #B98A52; }
.cn-bed--dirty .cn-bed__badge { color: #FFFFFF; }
.cn-bed--cleaning { background-color: #E8D9BF; }
.cn-bed--closed { background-color: var(--outline); }
.cn-bed--ready { background-color: var(--success); }
.cn-bed--ready .cn-bed__badge { color: #FFFFFF; }
.cn-bed--board { background-color: var(--warning); }
.cn-bed--tag0 .cn-bed__badge, .cn-wait--tag0 .cn-wait__badge { color: #4CB860; }
.cn-bed--tag1 .cn-bed__badge, .cn-wait--tag1 .cn-wait__badge { color: #D9A800; }
.cn-bed--tag2 .cn-bed__badge, .cn-wait--tag2 .cn-wait__badge { color: #F08A3C; }
.cn-bed--tag3 .cn-bed__badge, .cn-wait--tag3 .cn-wait__badge { color: #E0533F; }
.cn-bed--target { border-color: var(--primary); border-width: 4px; }
/* waiting patient chips */
.cn-wait { position: absolute; width: 48px; height: 48px; margin-left: -24px; margin-top: -48px; border-radius: 24px; border-width: 2px;
  border-color: var(--outline); background-color: var(--surface); align-items: center; justify-content: center; padding: 0; }
.cn-wait__badge { font-size: var(--type-title); color: var(--on-surface); -unity-font-style: bold; -unity-text-align: middle-center; }
.cn-wait--new { border-color: var(--primary); }
.cn-wait--selected { border-color: var(--accent); border-width: 4px; }
.cn-wait--more .cn-wait__badge { font-size: var(--type-label); }

.cn-coach { position: absolute; left: var(--space-m); right: var(--space-m); bottom: 190px; background-color: var(--surface-high);
  border-radius: var(--radius-l); padding: var(--space-m); flex-direction: row; align-items: center; }
.cn-coach--top { bottom: auto; top: 150px; }
.cn-coach__face { width: 72px; height: 72px; border-radius: 36px; margin-right: var(--space-m); background-color: var(--primary-container); flex-shrink: 0; }
.cn-coach__texts { flex-shrink: 1; flex-grow: 1; }
.cn-coach__text { font-size: var(--type-body); color: var(--on-surface); white-space: normal; }
.cn-coach__step { font-size: var(--type-caption); color: var(--on-surface-muted); margin-top: var(--space-xxs); }
.cn-coach__skip { align-self: flex-start; }
.cn-spot { position: absolute; width: 96px; height: 96px; margin-left: -48px; margin-top: -48px; border-radius: 48px;
  border-width: 4px; border-color: var(--accent); }
.cn-spot--pulse { scale: 1.12 1.12; }

.cn-report__stars { flex-direction: row; justify-content: space-between; margin: var(--space-s) 0; }
.cn-report__star { flex-grow: 1; align-items: center; }
.cn-report__star-value { font-size: var(--type-title); color: var(--accent); -unity-font-style: bold; }
.cn-row { flex-direction: row; justify-content: space-between; padding: var(--space-xxs) 0; }
.cn-row__k { font-size: var(--type-body); color: var(--on-surface-muted); }
.cn-row__v { font-size: var(--type-body); color: var(--on-surface); -unity-font-style: bold; }
.cn-row__v--good { color: var(--success); }
.cn-row__v--bad { color: var(--danger); }

.cn-pager { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--background); padding: var(--space-xl) var(--space-l); }
.cn-pager__art { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; margin-bottom: var(--space-l); }
.cn-pager__title { font-size: var(--type-headline); color: var(--on-surface); -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.cn-pager__body { font-size: var(--type-body-l); color: var(--on-surface-muted); -unity-text-align: middle-center; white-space: normal; margin: var(--space-s) 0 var(--space-l) 0; }
.cn-pager__dots { flex-direction: row; justify-content: center; margin-bottom: var(--space-l); }
.cn-pager__dot { width: 10px; height: 10px; border-radius: 5px; margin: 0 6px; background-color: var(--outline); }
.cn-pager__dot--on { background-color: var(--primary); width: 26px; }
.cn-pager__actions { flex-direction: row; justify-content: space-between; align-items: center; }
