/* CoddyKit (Unity) — fleet design-2 components for UI Toolkit (games/tools/ui README §1-2, ui_kit.gd 2026-10-26 redesign).
   Values = CoddyTokens.uss (generated). Imported after the default runtime theme by CoddyRuntimeTheme.tss, so a kit class
   wins over the matching .unity-* rule of the same specificity; pseudo-classes are restated where the default theme has them.
   Weak devices: plain backgrounds / borders only (no shaders, no blur, no shadows); transitions only on state changes.
   UNVERIFIED in the editor until Unity is installed (USS warnings are printed at import). */

:root {
    color: var(--on-surface);
    font-size: var(--type-body);
    /* Unity 6 Advanced Text Generator (HarfBuzz/ICU shaping): needed for Devanagari (hi, the 10th language). Verify with the
       P5 glyph test; if the property is unknown in the installed version, hi falls back to unshaped text = P5 blocker. */
    -unity-text-generator: advanced;
}

/* ---------------------------------------------------------------- text styles */
.coddy-display { font-size: var(--type-display); -unity-font-style: bold; }
.coddy-headline { font-size: var(--type-headline); -unity-font-style: bold; }
.coddy-title { font-size: var(--type-title); -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.coddy-body { font-size: var(--type-body); white-space: normal; }
.coddy-body-muted { font-size: var(--type-body); color: var(--on-surface-muted); white-space: normal; }
.coddy-label-strong { font-size: var(--type-label); -unity-font-style: bold; white-space: normal; }
.coddy-caption-muted { font-size: var(--type-caption); color: var(--on-surface-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.coddy-overline { font-size: var(--type-overline); -unity-font-style: bold; letter-spacing: 1.5px; color: var(--on-surface-muted); flex-grow: 1; }
.coddy-divider { height: 1px; background-color: var(--outline); margin-top: var(--space-s); }

/* ---------------------------------------------------------------- buttons */
.coddy-button, .coddy-pill {
    min-height: var(--touch-min);
    padding: 0 var(--space-l);
    margin: 0;
    border-radius: var(--radius-pill);
    border-width: 0;
    border-bottom-width: var(--touch-lip);
    border-color: var(--primary-lip);
    background-color: var(--primary);
    color: var(--on-primary);
    font-size: var(--type-label);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: background-color, translate;
    transition-duration: 0.12s;
}
.coddy-button:hover, .coddy-pill:hover { background-color: var(--primary); }
.coddy-button:active, .coddy-pill:active { background-color: var(--primary-pressed); translate: 0 2px; border-bottom-width: 2px; }
.coddy-button:disabled, .coddy-pill:disabled { opacity: 0.45; }
.coddy-button { min-height: var(--touch-comfortable); font-size: var(--type-title); }

.coddy-pill--tonal { background-color: var(--surface-high); color: var(--on-surface); border-color: var(--surface-sunken); }
.coddy-pill--tonal:hover { background-color: var(--surface-high); }
.coddy-pill--tonal:active { background-color: var(--surface-variant); }
.coddy-pill--danger { background-color: var(--danger); color: var(--on-primary); border-color: var(--danger-container); }
.coddy-pill--danger:hover { background-color: var(--danger); }

/* Low tier: the action is coloured text (no pill box) — batches with the card's grey line */
.coddy-action-text {
    min-height: var(--touch-min);
    min-width: var(--touch-min);
    padding: 0 var(--space-s);
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--primary);
    font-size: var(--type-label);
    -unity-font-style: bold;
}
.coddy-action-text:hover, .coddy-action-text:active { background-color: rgba(0, 0, 0, 0); }
.coddy-action-text--tonal { color: var(--accent); }
.coddy-action-text:disabled { opacity: 0.45; }

/* close: 84 px touch rect, 56 px round chip look (the chip is the button itself, margins centre it in the 84 px slot) */
.coddy-close, .coddy-close--flat {
    width: 56px; height: 56px;
    margin: 14px;
    padding: 0;
    border-width: 0;
    border-radius: var(--radius-pill);
    background-color: var(--surface-high);
    color: var(--on-surface);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.coddy-close:hover { background-color: var(--surface-high); }
.coddy-close:active { background-color: var(--surface-variant); }
.coddy-close:disabled { opacity: 0.85; }
.coddy-close--flat { background-color: rgba(0, 0, 0, 0); }

/* ---------------------------------------------------------------- page header, tiles, badges */
.coddy-page-header { padding-bottom: var(--space-xs); flex-shrink: 0; }
.coddy-page-header__row { flex-direction: row; align-items: center; }
.coddy-page-header__texts { flex-grow: 1; flex-shrink: 1; margin-left: var(--space-m); justify-content: center; }
/* sheet titles / lines wrap (P5 layout gate: the graphics question's line was cut in 9 of 10 languages) */
.coddy-page-header__texts > * { flex-shrink: 0; }
.coddy-page-header__texts .coddy-caption-muted, .coddy-page-header__texts .coddy-title { white-space: normal; overflow: visible; text-overflow: clip; }
.coddy-page-header__tile { width: 52px; height: 52px; border-radius: var(--radius-s); background-color: var(--primary-container); align-items: center; justify-content: center; }
.coddy-tile { width: 64px; height: 64px; border-radius: var(--radius-m); background-color: var(--primary-container); align-items: center; justify-content: center; flex-shrink: 0; }
.coddy-tile__icon, .coddy-page-header__tile .coddy-tile__icon { width: 60%; height: 60%; --unity-image-tint-color: var(--primary); }
.coddy-badge { font-size: var(--type-caption); -unity-font-style: bold; color: var(--on-surface); background-color: var(--accent-container); border-radius: 16px; padding: 2px var(--space-s); margin-left: var(--space-xs); }

/* ---------------------------------------------------------------- list cards (one primary per card, on the right) */
.coddy-list-card, .coddy-empty-card {
    background-color: var(--surface-variant);
    border-radius: var(--radius-m);
    border-width: 1px;
    border-color: var(--outline);
    padding: var(--space-m);
    margin-bottom: var(--space-s);
}
.coddy-list-card--flat { padding: var(--space-s) var(--space-xs); margin-bottom: var(--space-xs); border-bottom-width: 1px; border-color: var(--outline); }
.coddy-list-card--locked .coddy-list-card__title { color: var(--on-surface-muted); }
.coddy-list-card--selected { border-color: var(--primary); border-width: 2px; }
.coddy-list-card__head { flex-direction: row; align-items: center; flex-wrap: wrap; }
/* the name column keeps >= 40 % of the row (German tablet 10-29: "Stadium Row" broke mid-word as a chip + a long pill
   took the rest); when the name and the side controls do not both fit, the side drops to its own line, right-aligned */
.coddy-list-card__texts { flex-grow: 1; flex-shrink: 1; min-width: 40%; margin-left: var(--space-m); margin-right: var(--space-s); }
.coddy-list-card--flat .coddy-list-card__texts { margin-left: 0; }
.coddy-list-card__side { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: auto; }
/* a card's title + line wrap instead of ending in "…" (Volt City P5 layout gate 10-29: 7,188 ellipsized lines in
   10 languages x 4 aspects lost their numbers) and never shrink below their text height */
.coddy-list-card__texts > * { flex-shrink: 0; }
.coddy-list-card__texts .coddy-caption-muted, .coddy-list-card__texts .coddy-title { white-space: normal; overflow: visible; text-overflow: clip; }
.coddy-empty-card { align-items: flex-start; }

.coddy-section { flex-direction: row; align-items: center; margin-top: var(--space-s); margin-bottom: var(--space-xs); padding: 0 4px; }

/* ---------------------------------------------------------------- lists (§16: no visible scroller) */
.coddy-list { flex-grow: 1; }
.coddy-list .unity-scroller { display: none; }

/* ---------------------------------------------------------------- sheet + scrim (portrait windows) */
.coddy-scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--scrim-dim); justify-content: flex-end; }
.coddy-sheet {
    background-color: var(--background);
    border-top-left-radius: var(--radius-l);
    border-top-right-radius: var(--radius-l);
    border-top-width: 1px;
    border-color: var(--outline);
    padding: var(--space-s) var(--space-l) var(--space-l) var(--space-l);
}
.coddy-sheet__handle { width: 64px; height: 8px; border-radius: 4px; background-color: var(--outline); align-self: center; margin-bottom: var(--space-s); }
.coddy-sheet__body { flex-shrink: 1; margin-top: var(--space-s); }
.coddy-sheet__actions { flex-direction: row; justify-content: flex-end; margin-top: var(--space-s); }

/* ---------------------------------------------------------------- toasts (always a card) */
.coddy-toast-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; }
.coddy-toast {
    margin-top: var(--space-m);
    max-width: 92%;
    background-color: var(--surface-high);
    border-radius: var(--radius-m);
    border-left-width: 6px;
    border-color: var(--info);
    padding: var(--space-m) var(--space-l);
}
.coddy-toast--success { border-color: var(--success); }
.coddy-toast--warning { border-color: var(--warning); }
.coddy-toast--danger { border-color: var(--danger); }
.coddy-toast__text { white-space: normal; -unity-text-align: middle-left; flex-shrink: 0; width: 100%; }
/* a definite width: an auto-width centred card measured a wrapping label's height at its one-line width (3:4 tablet,
   P5 layout gate 10-29: two-line toast drawn one line tall) */
.coddy-toast { flex-shrink: 0; width: 92%; }

/* ---------------------------------------------------------------- house banner (sizes set from BannerMetrics in C#) */
.coddy-banner {
    position: absolute; left: 0; right: 0; bottom: 0;
    flex-direction: row;
    background-color: var(--surface-sunken);
    border-top-width: 1px;
    border-color: var(--outline);
}
.coddy-banner__tile { flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; }
.coddy-banner__divider { width: 1px; background-color: var(--outline); margin: 8px 0; }
.coddy-banner__icon { border-radius: var(--radius-s); flex-shrink: 0; }
.coddy-banner__texts { flex-grow: 1; flex-shrink: 1; justify-content: center; overflow: hidden; }
.coddy-banner__title { -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.coddy-banner__slogan { color: var(--on-surface-muted); white-space: nowrap; overflow: hidden; }
.coddy-banner__install, .coddy-banner__chip {
    margin: 0;
    border-width: 0;
    border-radius: var(--radius-pill);
    background-color: var(--primary);
    color: var(--on-primary);
    -unity-font-style: bold;
    white-space: nowrap;
    flex-shrink: 0;
}
.coddy-banner__install:hover, .coddy-banner__chip:hover { background-color: var(--primary); }
.coddy-banner__install:active, .coddy-banner__chip:active { background-color: var(--primary-pressed); }

/* ---------------------------------------------------------------- house interstitial card */
.coddy-interstitial { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.coddy-interstitial__stage { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
.coddy-interstitial__hero { position: absolute; left: 0; top: 0; right: 0; bottom: 22%; opacity: 0; }
.coddy-interstitial__hero--on { opacity: 1; }
.coddy-interstitial__hero--animated { transition-property: opacity, scale; transition-duration: 0.9s, 6s; scale: 1 1; }
.coddy-interstitial__hero--animated.coddy-interstitial__hero--on { scale: 1.06 1.06; }
.coddy-interstitial__big-icon { width: 46%; height: 46%; margin-bottom: 22%; border-radius: var(--radius-xl); }
.coddy-interstitial__content { position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: space-between; }
.coddy-interstitial__close { align-self: flex-end; }
.coddy-interstitial__panel {
    background-color: var(--background);
    border-top-left-radius: var(--radius-l);
    border-top-right-radius: var(--radius-l);
    padding: var(--space-l);
}
.coddy-interstitial__head { flex-direction: row; align-items: center; margin-bottom: var(--space-m); }
.coddy-interstitial__icon { width: 96px; height: 96px; border-radius: var(--radius-m); flex-shrink: 0; }
.coddy-interstitial__texts { flex-grow: 1; flex-shrink: 1; margin-left: var(--space-m); overflow: hidden; }
.coddy-interstitial__title { font-size: var(--type-title); -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.coddy-interstitial__slogan { font-size: var(--type-body); color: var(--on-surface-muted); white-space: nowrap; overflow: hidden; }
.coddy-interstitial__install { width: 100%; }

/* ---------------------------------------------------------------- boot curtain */
.coddy-curtain { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--background); justify-content: flex-end; align-items: center; }
.coddy-curtain__art { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.coddy-curtain__progress { width: 46%; height: 10px; border-radius: 5px; background-color: var(--surface-variant); margin-bottom: 12%; overflow: hidden; }
.coddy-curtain__bar { height: 100%; width: 0; background-color: var(--primary); border-radius: 5px; }
.coddy-curtain__status { font-size: var(--type-caption); color: var(--on-surface-muted); margin-bottom: var(--space-m); }

/* ---------------------------------------------------------------- icons (UiKit.Icon / WithIcon; white PNG tinted here) */
.coddy-icon { width: 30px; height: 30px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--on-surface); }
.coddy-has-icon { flex-direction: row; align-items: center; justify-content: center; }
.coddy-icon-label { margin-left: 6px; padding: 0; -unity-font-style: bold; color: var(--on-surface); }
.coddy-close .coddy-icon, .coddy-close--flat .coddy-icon { width: 24px; height: 24px; }
