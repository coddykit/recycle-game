/* Ridgeback Rangers — game styles on top of the CoddyKit theme (CoddyTokens.uss / CoddyKit.uss). Fleet UI rules: ≥ 48 dp
   touch targets (--touch-min), ≥ 14 sp body text, every toast a card, no raw Godot/Unity look, no visible scrollbar. */
.rr-root { flex-grow: 1; }
.rr-hud { position: absolute; left: 0; right: 0; top: 0; flex-direction: column; padding: var(--space-s) var(--space-m); }
.rr-hud__row { flex-direction: row; align-items: center; justify-content: space-between; }
.rr-chip { flex-direction: row; align-items: center; background-color: var(--surface); border-radius: var(--radius-pill);
  padding: var(--space-xs) var(--space-m); margin-right: var(--space-xs); min-height: var(--touch-min); }
.rr-chip__label { font-size: var(--type-label); color: var(--on-surface); -unity-font-style: bold; }
.rr-chip__sub { font-size: var(--type-caption); color: var(--on-surface-muted); margin-left: var(--space-xs); }
.rr-chip--money .rr-chip__label { color: var(--success); }
.rr-chip--warn { background-color: var(--warning-container); }
.rr-crises { flex-direction: row; flex-wrap: wrap; margin-top: var(--space-xs); }
.rr-speed { flex-direction: row; }
.rr-speed__btn { min-width: var(--touch-min); min-height: var(--touch-min); margin-left: var(--space-xxs); border-radius: var(--radius-pill);
  background-color: var(--surface); color: var(--on-surface); font-size: var(--type-label); -unity-font-style: bold; border-width: 0; }
.rr-speed__btn--on { background-color: var(--primary); color: var(--on-primary); }
.rr-main-action { margin-top: var(--space-s); align-self: center; min-width: 220px; }

.rr-bottom { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: column; }
.rr-tabs { flex-direction: row; background-color: var(--surface); min-height: var(--touch-tab-bar); border-top-left-radius: var(--radius-l); border-top-right-radius: var(--radius-l); }
.rr-tab { flex-grow: 1; flex-basis: 0; min-height: var(--touch-tab-bar); background-color: rgba(0,0,0,0); border-width: 0;
  font-size: var(--type-caption); color: var(--on-surface-muted); -unity-font-style: bold; white-space: normal; }
.rr-tab--on { color: var(--primary); }
.rr-markers { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.rr-marker { position: absolute; min-width: 56px; min-height: var(--touch-min); margin-left: -28px; margin-top: -30px; border-radius: var(--radius-pill);
  background-color: var(--surface); color: var(--on-surface); font-size: var(--type-label); -unity-font-style: bold; border-width: 2px;
  border-color: var(--outline); padding: 0 var(--space-s); }
.rr-marker--pin { border-color: var(--warning); }
.rr-marker--pin-sick { border-color: var(--danger); }
.rr-marker--pin-escape { background-color: var(--danger); color: var(--on-primary); }
.rr-marker--urgent { background-color: var(--warning-container); border-width: 3px; }
.rr-marker--taken { opacity: 0.75; border-color: var(--success); }
.rr-marker--selected { border-color: var(--primary); border-width: 3px; }
.rr-marker--slot { min-width: var(--touch-min); font-size: var(--type-title); color: var(--primary); border-style: dashed; }
.rr-marker--gate { background-color: var(--primary); color: var(--on-primary); border-width: 0; }
.rr-marker--tram { font-size: var(--type-caption); }
.rr-marker--ready { background-color: var(--accent); color: var(--on-accent); border-width: 0; }
.rr-marker--fed { background-color: var(--success); color: var(--on-primary); border-width: 0; min-width: 120px; margin-left: -60px; }
.rr-badge { min-height: var(--touch-min); border-radius: var(--radius-pill); background-color: var(--primary); color: var(--on-primary);
  font-size: var(--type-label); -unity-font-style: bold; border-width: 0; padding: 0 var(--space-m); margin-right: var(--space-xs); }
.rr-chip--cp .rr-chip__label { color: var(--primary); }
.rr-bar { margin: var(--space-xs) 0; }
.rr-bar__track { height: 12px; border-radius: 6px; background-color: var(--surface-variant); overflow: hidden; margin-top: var(--space-xxs); }
.rr-bar__fill { height: 100%; border-radius: 6px; }
.rr-bar__fill--good { background-color: var(--success); }
.rr-bar__fill--warn { background-color: var(--warning); }
.rr-bar__fill--bad { background-color: var(--danger); }
.rr-slider { min-height: var(--touch-min); margin: var(--space-xs) 0; }
.rr-pill-label { font-size: var(--type-caption); color: var(--on-surface-muted); background-color: var(--surface-variant); border-radius: var(--radius-pill);
  padding: var(--space-xxs) var(--space-s); margin: 0 var(--space-xxs) var(--space-xxs) 0; }
.rr-swipe { position: absolute; left: 45%; top: 45%; font-size: 48px; color: var(--on-primary); -unity-font-style: bold; }

.rr-coach { position: absolute; left: var(--space-m); right: var(--space-m); bottom: 190px; background-color: var(--surface-high);
  border-radius: var(--radius-l); padding: var(--space-m); flex-direction: row; align-items: center; }
.rr-coach--top { bottom: auto; top: 150px; }
.rr-coach__face { width: 72px; height: 72px; border-radius: 36px; margin-right: var(--space-m); background-color: var(--primary-container); flex-shrink: 0; }
.rr-coach__texts { flex-shrink: 1; flex-grow: 1; }
.rr-coach__text { font-size: var(--type-body); color: var(--on-surface); white-space: normal; }
.rr-coach__step { font-size: var(--type-caption); color: var(--on-surface-muted); margin-top: var(--space-xxs); }
.rr-coach__skip { align-self: flex-start; }
.rr-spot { position: absolute; width: 96px; height: 96px; margin-left: -48px; margin-top: -48px; border-radius: 48px;
  border-width: 4px; border-color: var(--accent); }
.rr-spot--pulse { scale: 1.12 1.12; }

.rr-report__stars { flex-direction: row; justify-content: space-between; margin: var(--space-s) 0; }
.rr-report__star { flex-grow: 1; align-items: center; }
.rr-report__star-value { font-size: var(--type-title); color: var(--accent); -unity-font-style: bold; }
.rr-row { flex-direction: row; justify-content: space-between; padding: var(--space-xxs) 0; }
.rr-row__k { font-size: var(--type-body); color: var(--on-surface-muted); }
.rr-row__v { font-size: var(--type-body); color: var(--on-surface); -unity-font-style: bold; }
.rr-row__v--good { color: var(--success); }
.rr-row__v--bad { color: var(--danger); }

.rr-pager { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--background); padding: var(--space-xl) var(--space-l); }
.rr-pager__art { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; margin-bottom: var(--space-l); }
.rr-pager__title { font-size: var(--type-headline); color: var(--on-surface); -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.rr-pager__body { font-size: var(--type-body-l); color: var(--on-surface-muted); -unity-text-align: middle-center; white-space: normal; margin: var(--space-s) 0 var(--space-l) 0; }
.rr-pager__dots { flex-direction: row; justify-content: center; margin-bottom: var(--space-l); }
.rr-pager__dot { width: 10px; height: 10px; border-radius: 5px; margin: 0 6px; background-color: var(--outline); }
.rr-pager__dot--on { background-color: var(--primary); width: 26px; }
.rr-pager__actions { flex-direction: row; justify-content: space-between; align-items: center; }
