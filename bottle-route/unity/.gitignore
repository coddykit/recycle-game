# Unity 6 project (bottle-route/unity). Generated / machine-local folders never go into git.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Assets/Plugins/Android/gradleOut/
# IDE / solution files (regenerated by the editor)
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
# Crash reports / build products
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.symbols.zip
*.unitypackage
# Gradle / Android local files the editor may write
/Assets/Plugins/Android/*.gradle.bak
local.properties
# Signing material is NEVER in git (CI reads it from Jenkins credentials)
*.keystore
*.jks
keystore.properties
# Unity license files are NEVER in git
*.ulf
*.alf
# EDM4U / GMA local resolution caches
/Assets/GooglePlayGames/
/Assets/ExternalDependencyManager/Editor/*.log
/.utmp/
/Packages/tarballs/
# Firebase config is copied in only for the build (BottleAndroidBuild) — never commit it or what it generates
/Assets/google-services.json*
/Assets/StreamingAssets/google-services-desktop.json*
/Assets/Plugins/Android/FirebaseApp.androidlib*
# EDM / Firebase resolver output (regenerated from the package tarballs on every resolve)
/Assets/GeneratedLocalRepo/
/Assets/GeneratedLocalRepo.meta
/Assets/StreamingAssets/
/Assets/StreamingAssets.meta
/Assets/Resources/PerformanceTestRun*
