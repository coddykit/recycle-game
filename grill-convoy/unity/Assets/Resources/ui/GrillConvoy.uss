/* Grill Convoy — game styles on top of the CoddyKit theme (CoddyTokens.uss / CoddyKit.uss). Fleet UI rules: ≥ 48 dp
   touch targets (--touch-min), ≥ 14 sp body text, every toast a card, no raw Godot/Unity look, no visible scrollbar. */
.gc-root { flex-grow: 1; }
.gc-hud { position: absolute; left: 0; right: 0; top: 0; flex-direction: column; padding: var(--space-s) var(--space-m); }
.gc-hud__row { flex-direction: row; align-items: center; justify-content: space-between; }
.gc-chip { flex-direction: row; align-items: center; background-color: var(--surface); border-radius: var(--radius-pill);
  padding: var(--space-xs) var(--space-m); margin-right: var(--space-xs); min-height: var(--touch-min); }
.gc-chip__label { font-size: var(--type-label); color: var(--on-surface); -unity-font-style: bold; }
.gc-chip__sub { font-size: var(--type-caption); color: var(--on-surface-muted); margin-left: var(--space-xs); }
.gc-chip--money .gc-chip__label { color: var(--success); }
.gc-chip--warn { background-color: var(--warning-container); }
.gc-crises { flex-direction: row; flex-wrap: wrap; margin-top: var(--space-xs); }
.gc-speed { flex-direction: row; }
.gc-speed__btn { min-width: var(--touch-min); min-height: var(--touch-min); margin-left: var(--space-xxs); border-radius: var(--radius-pill);
  background-color: var(--surface); color: var(--on-surface); font-size: var(--type-label); -unity-font-style: bold; border-width: 0; }
.gc-speed__btn--on { background-color: var(--primary); color: var(--on-primary); }
.gc-main-action { margin-top: var(--space-s); align-self: center; min-width: 220px; }

.gc-cook { margin-top: var(--space-s); align-self: center; min-width: 240px; min-height: 64px; font-size: var(--type-title); }

.gc-bottom { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: column; }
.gc-tabs { flex-direction: row; background-color: var(--surface); min-height: var(--touch-tab-bar); border-top-left-radius: var(--radius-l); border-top-right-radius: var(--radius-l); }
.gc-tab { flex-grow: 1; flex-basis: 0; min-height: var(--touch-tab-bar); background-color: rgba(0,0,0,0); border-width: 0;
  font-size: var(--type-caption); color: var(--on-surface-muted); -unity-font-style: bold; white-space: normal; }
.gc-tab--on { color: var(--primary); }
.gc-truckbar { flex-direction: column; background-color: var(--surface-high); margin: 0 var(--space-m) var(--space-s) var(--space-m);
  border-radius: var(--radius-l); padding: var(--space-s) var(--space-m); }
.gc-truckbar__row { flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-top: var(--space-xxs); }
.gc-truckbar__info { font-size: var(--type-caption); color: var(--on-surface-muted); white-space: normal; }
.coddy-pill--danger { background-color: var(--danger); color: var(--on-primary); }

.gc-markers { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.gc-marker { position: absolute; min-width: 56px; min-height: var(--touch-min); margin-left: -28px; margin-top: -56px; align-items: center;
  background-color: rgba(0,0,0,0); border-width: 0; padding: 0; }
.gc-marker__badge { font-size: var(--type-caption); color: var(--on-surface); -unity-font-style: bold; background-color: var(--surface);
  border-radius: var(--radius-pill); padding: 0 var(--space-xs); }
.gc-marker__gauge { width: 44px; height: 8px; margin-top: var(--space-xxs); background-color: var(--surface); border-radius: var(--radius-xs);
  border-width: 1px; border-color: var(--outline); overflow: hidden; }
.gc-marker__fill { height: 100%; background-color: var(--success); }
.gc-marker__fill--low { background-color: var(--danger); }
.gc-marker--busy .gc-marker__badge { background-color: var(--warning); color: var(--on-primary); }
.gc-marker--selected .gc-marker__badge { background-color: var(--primary); color: var(--on-primary); }
.gc-place { position: absolute; min-height: var(--touch-min); min-width: var(--touch-min); margin-left: -60px; margin-top: -24px;
  border-radius: var(--radius-pill); background-color: var(--surface); color: var(--on-surface); font-size: var(--type-caption);
  -unity-font-style: bold; border-width: 0; padding: 0 var(--space-s); }
.gc-place--locked { opacity: 0.7; color: var(--on-surface-muted); }

.gc-coach { position: absolute; left: var(--space-m); right: var(--space-m); bottom: 190px; background-color: var(--surface-high);
  border-radius: var(--radius-l); padding: var(--space-m); flex-direction: row; align-items: center; }
.gc-coach--top { bottom: auto; top: 150px; }
.gc-coach__face { width: 72px; height: 72px; border-radius: 36px; margin-right: var(--space-m); background-color: var(--primary-container); flex-shrink: 0; }
.gc-coach__texts { flex-shrink: 1; flex-grow: 1; }
.gc-coach__text { font-size: var(--type-body); color: var(--on-surface); white-space: normal; }
.gc-coach__step { font-size: var(--type-caption); color: var(--on-surface-muted); margin-top: var(--space-xxs); }
.gc-coach__skip { align-self: flex-start; }
.gc-spot { position: absolute; width: 96px; height: 96px; margin-left: -48px; margin-top: -48px; border-radius: 48px;
  border-width: 4px; border-color: var(--accent); }
.gc-spot--pulse { scale: 1.12 1.12; }

.gc-report__stars { flex-direction: row; justify-content: space-between; margin: var(--space-s) 0; }
.gc-report__star { flex-grow: 1; align-items: center; }
.gc-report__star-value { font-size: var(--type-title); color: var(--accent); -unity-font-style: bold; }
.gc-row { flex-direction: row; justify-content: space-between; padding: var(--space-xxs) 0; }
.gc-row__k { font-size: var(--type-body); color: var(--on-surface-muted); }
.gc-row__v { font-size: var(--type-body); color: var(--on-surface); -unity-font-style: bold; }
.gc-row__v--good { color: var(--success); }
.gc-row__v--bad { color: var(--danger); }

.gc-pager { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--background); padding: var(--space-xl) var(--space-l); }
.gc-pager__art { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; margin-bottom: var(--space-l); }
.gc-pager__title { font-size: var(--type-headline); color: var(--on-surface); -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.gc-pager__body { font-size: var(--type-body-l); color: var(--on-surface-muted); -unity-text-align: middle-center; white-space: normal; margin: var(--space-s) 0 var(--space-l) 0; }
.gc-pager__dots { flex-direction: row; justify-content: center; margin-bottom: var(--space-l); }
.gc-pager__dot { width: 10px; height: 10px; border-radius: 5px; margin: 0 6px; background-color: var(--outline); }
.gc-pager__dot--on { background-color: var(--primary); width: 26px; }
.gc-pager__actions { flex-direction: row; justify-content: space-between; align-items: center; }

.gc-chips { flex-direction: row; flex-wrap: wrap; margin: var(--space-xxs) 0; }
.gc-pack { flex-direction: row; align-items: center; justify-content: space-between; padding: var(--space-xxs) 0; }
.gc-pack__label { flex-grow: 1; flex-shrink: 1; font-size: var(--type-body); color: var(--on-surface); white-space: normal; }
.gc-grid { flex-direction: column; align-items: center; margin: var(--space-s) 0; padding: var(--space-xs); background-color: var(--surface-high);
  border-radius: var(--radius-m); }
.gc-grid__row { flex-direction: row; }
.gc-tile { width: 64px; height: 56px; margin: 2px; border-radius: var(--radius-s); border-width: 2px; border-color: var(--outline);
  background-color: var(--surface); color: var(--on-surface); font-size: 14px; -unity-font-style: bold; white-space: normal; padding: 2px; }
.gc-tile--front { border-top-width: 4px; border-top-color: var(--accent); }
.gc-tile--selected { border-color: var(--primary); border-width: 4px; }
.gc-tile--grill { background-color: rgb(107, 58, 38); color: rgb(255, 255, 255); }
.gc-tile--assembly { background-color: rgb(227, 168, 87); }
.gc-tile--window { background-color: rgb(95, 168, 160); color: rgb(255, 255, 255); }
.gc-tile--toaster { background-color: rgb(246, 196, 67); }
.gc-tile--fryer { background-color: rgb(245, 200, 66); }
.gc-tile--sauce { background-color: rgb(224, 83, 63); color: rgb(255, 255, 255); }
.gc-tile--fridge { background-color: rgb(47, 168, 200); color: rgb(255, 255, 255); }
.gc-tile--wrap { background-color: rgb(124, 194, 76); }
